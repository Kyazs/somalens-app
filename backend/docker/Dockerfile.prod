# Build stage
FROM python:3.10-slim as builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    unzip \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install uv
RUN pip install uv

# Copy and install dependencies
COPY pyproject.toml ./
RUN uv pip install --system --extra-index-url https://download.pytorch.org/whl/cpu -e .

# Pre-download DeepLabV3 weights
ENV TORCH_HOME=/app/models/torch
RUN mkdir -p /app/models && \
    python -c "import torchvision; import torch; url = torchvision.models.segmentation.DeepLabV3_ResNet101_Weights.DEFAULT.url; torch.hub.download_url_to_file(url, '/app/models/deeplabv3_resnet101.pth')"

# Pre-download ZoeDepth model weights (1.34GB), repos, and MediaPipe pose landmarker
RUN mkdir -p /app/models/zoedepth/hub/checkpoints /app/models/mediapipe && \
    curl -L -o /app/models/zoedepth/hub/checkpoints/ZoeD_M12_N.pt \
    "https://github.com/isl-org/ZoeDepth/releases/download/v1.0/ZoeD_M12_N.pt" && \
    echo "Downloaded ZoeD_M12_N.pt" && \
    curl -L -o /tmp/midas.zip "https://github.com/intel-isl/MiDaS/zipball/master" && \
    unzip -q /tmp/midas.zip -d /tmp/midas_tmp && \
    mv /tmp/midas_tmp/intel-isl-MiDaS-* /app/models/zoedepth/hub/intel-isl_MiDaS_master && \
    rm /tmp/midas.zip && rm -rf /tmp/midas_tmp && \
    echo "Downloaded MiDaS repo" && \
    curl -L -o /tmp/zoedepth.zip "https://github.com/isl-org/ZoeDepth/zipball/main" && \
    unzip -q /tmp/zoedepth.zip -d /tmp/zoedepth_tmp && \
    mv /tmp/zoedepth_tmp/isl-org-ZoeDepth-* /app/models/zoedepth/hub/isl-org_ZoeDepth_main && \
    rm /tmp/zoedepth.zip && rm -rf /tmp/zoedepth_tmp && \
    echo "Downloaded ZoeDepth repo" && \
    curl -L -o /app/models/mediapipe/pose_landmarker_heavy.task \
    "https://storage.googleapis.com/mediapipe-models/pose_landmarker/pose_landmarker_heavy/float16/latest/pose_landmarker_heavy.task" && \
    echo "Downloaded MediaPipe pose landmarker"

# Production stage
FROM python:3.10-slim

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN groupadd -r appgroup && useradd -r -g appgroup appuser

WORKDIR /app

# Copy installed packages from builder
COPY --from=builder /usr/local/lib/python3.10/site-packages /usr/local/lib/python3.10/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy torch models from builder
COPY --from=builder /app/models /app/models
ENV TORCH_HOME=/app/data/torch

# Copy application code
COPY app/ ./app/
COPY alembic.ini ./
COPY alembic/ ./alembic/
COPY data/ ./data/

# Copy pre-downloaded ZoeDepth & MediaPipe models to the app's expected cache location
RUN mkdir -p /app/app/ml_models && \
    cp -r /app/models/zoedepth /app/app/ml_models/zoedepth && \
    cp -r /app/models/mediapipe /app/app/ml_models/mediapipe

# Create directories and set permissions (uploads dir created here for proper ownership)
RUN mkdir -p /app/data /app/uploads && chown -R appuser:appgroup /app

# Switch to non-root user
USER appuser

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Run with multiple workers (production optimized)
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]
