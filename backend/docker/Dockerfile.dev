FROM python:3.10-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast dependency management
RUN pip install uv

# Set working directory
WORKDIR /app

# Copy dependency files
COPY pyproject.toml ./

# Install dependencies using uv (with PyTorch CPU for ML pipeline)
RUN uv pip install --system --extra-index-url https://download.pytorch.org/whl/cpu -e .

# Copy application code
COPY app/ ./app/

# Expose port
EXPOSE 8000

# Enable WAL mode for SQLite (handled in database.py at runtime)
# This allows concurrent reads during writes

# Run FastAPI with hot reload
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
