FROM python:3.10-slim

# Install system dependencies (curl + OpenCV/MediaPipe runtime libs)
RUN apt-get update && apt-get install -y \
    curl \
    unzip \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast dependency management
RUN pip install uv

# Set working directory
WORKDIR /app

# Copy dependency files
COPY pyproject.toml ./

# Install dependencies using uv (with PyTorch CPU for ML pipeline)
RUN uv pip install --system --extra-index-url https://download.pytorch.org/whl/cpu -e .

# Copy application code
COPY app/ ./app/

# Pre-download ZoeDepth model weights (1.34GB), repos, and MediaPipe pose landmarker
RUN mkdir -p /app/app/ml_models/zoedepth/hub/checkpoints /app/app/ml_models/mediapipe && \
    curl -L -o /app/app/ml_models/zoedepth/hub/checkpoints/ZoeD_M12_N.pt \
    "https://github.com/isl-org/ZoeDepth/releases/download/v1.0/ZoeD_M12_N.pt" && \
    echo "Downloaded ZoeD_M12_N.pt" && \
    curl -L -o /tmp/midas.zip "https://github.com/intel-isl/MiDaS/zipball/master" && \
    unzip -q /tmp/midas.zip -d /tmp/midas_tmp && \
    mv /tmp/midas_tmp/intel-isl-MiDaS-* /app/app/ml_models/zoedepth/hub/intel-isl_MiDaS_master && \
    rm /tmp/midas.zip && rm -rf /tmp/midas_tmp && \
    echo "Downloaded MiDaS repo" && \
    curl -L -o /tmp/zoedepth.zip "https://github.com/isl-org/ZoeDepth/zipball/main" && \
    unzip -q /tmp/zoedepth.zip -d /tmp/zoedepth_tmp && \
    mv /tmp/zoedepth_tmp/isl-org-ZoeDepth-* /app/app/ml_models/zoedepth/hub/isl-org_ZoeDepth_main && \
    rm /tmp/zoedepth.zip && rm -rf /tmp/zoedepth_tmp && \
    echo "Downloaded ZoeDepth repo" && \
    curl -L -o /app/app/ml_models/mediapipe/pose_landmarker_heavy.task \
    "https://storage.googleapis.com/mediapipe-models/pose_landmarker/pose_landmarker_heavy/float16/latest/pose_landmarker_heavy.task" && \
    echo "Downloaded MediaPipe pose landmarker"

# Expose port
EXPOSE 8000

# Enable WAL mode for SQLite (handled in database.py at runtime)
# This allows concurrent reads during writes

# Run FastAPI with hot reload
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
